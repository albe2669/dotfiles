+// sibling_modules returns module directories (dirs containing v.mod) that
+// sit next to the working dir. V resolves `import x` through these, so the
+// temp project must mirror them or cross-module imports cannot compile.
+fn sibling_modules(working_dir string) []string {
+	parent := os.dir(working_dir)
+	if parent == '' || parent == working_dir {
+		return []
+	}
+	mut modules := []string{}
+	for entry in os.ls(parent) or { return [] } {
+		if entry == '' || entry[0] == `.` {
+			continue
+		}
+		candidate := os.join_path(parent, entry)
+		if !os.is_dir(candidate) {
+			continue
+		}
+		if os.exists(os.join_path(candidate, 'v.mod')) && candidate != working_dir {
+			modules << candidate
+		}
+	}
+	return modules
+}
