+		link_target := os.join_path(os.dir(os.real_path(temp_project_dir)), name)
+		if os.exists(link_target) {
+			continue
+		}
+		os.symlink(module_dir, link_target) or {
+			log('Failed to symlink sibling module ${module_dir}: ${err}')
+			continue
+		}
+		log('Symlinked sibling module: ${module_dir} -> ${link_target}')
+	}
