{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "synapse": {
      "type": "remote",
      "url": "https://mcp.synapse.corti.app/mcp",
      "enabled": true,
      "oauth": {
        "clientId": "synapse-mcp",
        "scope": "openid email profile",
        "prompt": "none"
      }
    }
  },
  "providers": {
    "corti": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "Corti",
