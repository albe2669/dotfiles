        "apiKey": "{env:CORTI_BEARER}"
      },
      "models": {
        "corti-s1": {
          "name": "Corti S1",
          "limit": {
            "context": 262144,
            "output": 262144
          },
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "cost": {
            "input": 2,
            "output": 8,
            "cache": {
              "read": 0.2
            }
          },
